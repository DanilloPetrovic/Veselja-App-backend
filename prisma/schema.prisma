generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  events Event[]

  @@map("admins")
}

model Event {
  id             String   @id @default(uuid())
  title          String   
  slug           String   @unique 
  pinCode        String   @map("pin_code")
  welcomeMessage String?  @map("welcome_message")
  fontFamily     String?  @default("Tangerine") @map("font_family")
  coverImageUrl  String?  @map("cover_image_url")
  coverImageKey String? @map("cover_image_key")
  qrCodeUrl      String?  @map("qr_code_url")
  eventDate      DateTime @map("event_date")
  isActive       Boolean  @default(true) @map("is_active")

  adminId   String @map("admin_id")
  createdBy Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  media Media[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("events")
}

model Media {
  id             String  @id @default(uuid())
  fileUrl        String  @map("file_url")
  fileKey  String @map("file_key")
  fileType       String  @map("file_type")
  fileSize       Int?    @map("file_size")
  mimeType       String? @map("mime_type")

  guestSessionId String  @map("guest_session_id")

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventId])
  @@index([guestSessionId])
  @@map("media")
}